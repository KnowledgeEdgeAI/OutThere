OUTTHERE_DATABASE_URL=sqlite:///./data/outthere.db
OUTTHERE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OUTTHERE_ACCESS_TOKEN_SECONDS=900
OUTTHERE_REFRESH_TOKEN_SECONDS=2592000
OUTTHERE_SYNC_POLL_SECONDS=1.0
# Explicitly enable only when a restricted server key and billing are configured.
OUTTHERE_MAPS_PROVIDER=disabled
OUTTHERE_GOOGLE_MAPS_API_KEY=
# Optional database: install the postgres extra and migrate before starting.
# OUTTHERE_DATABASE_URL=postgresql+psycopg://outthere:change-me@localhost:5432/outthere
# V2 phone login is opt-in and does not prove number ownership.
OUTTHERE_AUTH_MODE=disabled
# For local v2 development: set mode to unverified_phone and generate a Fernet key.
# Keep that key stable across restarts and outside source control.
OUTTHERE_AUTH_RETRY_KEY=
OUTTHERE_AUTH_RETRY_SECONDS=300
OUTTHERE_ACTION_RETRY_SECONDS=604800
# Include your Expo browser origin when testing, e.g. http://localhost:8082.

# Private local media, one host only. Keep this directory outside public static serving.
OUTTHERE_MEDIA_DIRECTORY=./data/media
OUTTHERE_MATCH_JITTER_SECONDS=30
# Optional push adapters. JSON/key material must stay outside source control.
OUTTHERE_FCM_SERVICE_ACCOUNT=
OUTTHERE_APNS_PRIVATE_KEY=
OUTTHERE_APNS_KEY_ID=
OUTTHERE_APNS_TEAM_ID=
OUTTHERE_APNS_TOPIC=
OUTTHERE_APNS_SANDBOX=true
